{
  "$defs": {
    "AnswerGraph": {
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "computed": {
          "items": {
            "$ref": "#/$defs/ComputedResult"
          },
          "title": "Computed",
          "type": "array"
        }
      },
      "title": "AnswerGraph",
      "type": "object"
    },
    "AnswerSentence": {
      "additionalProperties": false,
      "description": "One sentence of a verified answer with the sources it cites and the verifier's verdict (Phase 5.1).\n\n``accepted``: a supplied triple states it. ``removed``: no triple supports it; it is not in the answer.\n``from_facts``: the composed answer had no supported sentence after one repair, so the answer states\nthe extracted facts themselves.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceids",
          "type": "array"
        },
        "verdict": {
          "enum": [
            "accepted",
            "removed",
            "from_facts"
          ],
          "title": "Verdict",
          "type": "string"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "text",
        "verdict"
      ],
      "title": "AnswerSentence",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "description": "One stage's outcome, so a failure names the stage that failed.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "warn",
            "fail",
            "skipped",
            "info"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "Check",
      "type": "object"
    },
    "ClaimField": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceids",
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "value",
        "sourceIds"
      ],
      "title": "ClaimField",
      "type": "object"
    },
    "ClaimRelation": {
      "additionalProperties": false,
      "properties": {
        "sourceClaim": {
          "title": "Sourceclaim",
          "type": "string"
        },
        "targetClaim": {
          "title": "Targetclaim",
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "qualifies",
            "sameContext",
            "differentContext",
            "possibleConflict",
            "confirmedConflict",
            "equivalentTo"
          ],
          "title": "Relation",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "sourceClaim",
        "targetClaim",
        "relation",
        "reason"
      ],
      "title": "ClaimRelation",
      "type": "object"
    },
    "ClaimSubgraph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "MetadataClaim",
            "ResultClaim",
            "ComparisonClaim",
            "MethodClaim",
            "LimitationClaim",
            "RankingClaim",
            "SynthesisClaim"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paperId": {
          "title": "Paperid",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/ClaimField"
          },
          "title": "Fields",
          "type": "object"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceids",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "object"
        },
        "evidenceAnchors": {
          "items": {
            "$ref": "#/$defs/EvidenceAnchor"
          },
          "title": "Evidenceanchors",
          "type": "array"
        },
        "supportedBy": {
          "items": {
            "type": "string"
          },
          "title": "Supportedby",
          "type": "array"
        },
        "status": {
          "default": "accepted",
          "enum": [
            "accepted",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "paperId",
        "fields",
        "sourceIds",
        "evidence"
      ],
      "title": "ClaimSubgraph",
      "type": "object"
    },
    "ComputedResult": {
      "additionalProperties": false,
      "description": "A conclusion the harness computed from source facts; never presented as a source fact.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "about": {
          "title": "About",
          "type": "string"
        },
        "derivedFrom": {
          "items": {
            "type": "string"
          },
          "title": "Derivedfrom",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "operation",
        "about"
      ],
      "title": "ComputedResult",
      "type": "object"
    },
    "ConceptChoice": {
      "additionalProperties": false,
      "description": "The research interpretation a run is bound to (agentic path).",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "gloss": {
          "title": "Gloss",
          "type": "string"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "searchTerms": {
          "items": {
            "type": "string"
          },
          "title": "Searchterms",
          "type": "array"
        },
        "evidenceHits": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidencehits"
        },
        "sampleSources": {
          "items": {
            "type": "string"
          },
          "title": "Samplesources",
          "type": "array"
        },
        "autoSelected": {
          "default": false,
          "title": "Autoselected",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "gloss"
      ],
      "title": "ConceptChoice",
      "type": "object"
    },
    "EvaluationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "corpusSnapshotId": {
          "title": "Corpussnapshotid",
          "type": "string"
        },
        "ontologyVersion": {
          "title": "Ontologyversion",
          "type": "string"
        },
        "claimSchemaVersion": {
          "title": "Claimschemaversion",
          "type": "string"
        },
        "goldVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goldversion"
        },
        "retrievalIndexVersion": {
          "title": "Retrievalindexversion",
          "type": "string"
        }
      },
      "required": [
        "corpusSnapshotId",
        "ontologyVersion",
        "claimSchemaVersion",
        "retrievalIndexVersion"
      ],
      "title": "EvaluationSnapshot",
      "type": "object"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "description": "A reproducible source location, independent of the tool that found it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "dblp_fact",
            "passage",
            "table_cell",
            "figure_annotation",
            "citation_fact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paperId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paperid"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Locator",
          "type": "object"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "id",
        "kind",
        "sourceId"
      ],
      "title": "EvidenceAnchor",
      "type": "object"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "description": "A source fact or claim field (``fact``/``claim``/``evidence``) or a computed step (``derived``).\n\n``origin`` says where a fact edge's predicate comes from: the DBLP ontology, the harness core\nvocabulary, or invented for this question (None for claim, evidence and derived edges).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "fact",
            "claim",
            "evidence",
            "derived"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceids",
          "type": "array"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence"
        },
        "origin": {
          "anyOf": [
            {
              "enum": [
                "dblp",
                "core",
                "invented"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Origin"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "label",
        "kind"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "description": "One entity in the answer graph; the same entity appears exactly once.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "enum": [
            "paper",
            "author",
            "value",
            "entity",
            "claim",
            "passage",
            "computed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "iri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Iri"
        }
      },
      "required": [
        "id",
        "label",
        "kind"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "disagreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disagreement"
        },
        "precision": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "gloss": {
          "title": "Gloss",
          "type": "string"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "axioms": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Axioms",
          "type": "array"
        },
        "sparql": {
          "title": "Sparql",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "triples": {
          "items": {
            "$ref": "#/$defs/Triple"
          },
          "title": "Triples",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimSubgraph"
          },
          "title": "Claims",
          "type": "array"
        },
        "claimRelations": {
          "items": {
            "$ref": "#/$defs/ClaimRelation"
          },
          "title": "Claimrelations",
          "type": "array"
        },
        "answerClaimIds": {
          "items": {
            "type": "string"
          },
          "title": "Answerclaimids",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "answered",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "op": {
          "default": "",
          "title": "Op",
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Properties"
        },
        "measure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Measure"
        },
        "graph": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnswerGraph"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schemaTerms": {
          "items": {
            "$ref": "#/$defs/SchemaTerm"
          },
          "title": "Schematerms",
          "type": "array"
        },
        "answerSentences": {
          "items": {
            "$ref": "#/$defs/AnswerSentence"
          },
          "title": "Answersentences",
          "type": "array"
        }
      },
      "required": [
        "label",
        "gloss",
        "classes",
        "axioms",
        "sparql",
        "answer",
        "triples",
        "metrics"
      ],
      "title": "Reading",
      "type": "object"
    },
    "SchemaTerm": {
      "additionalProperties": false,
      "description": "One class or property of a reading's subschema, as declared in OWL 2, with its origin.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "iri": {
          "title": "Iri",
          "type": "string"
        },
        "kind": {
          "enum": [
            "class",
            "object",
            "datatype"
          ],
          "title": "Kind",
          "type": "string"
        },
        "origin": {
          "enum": [
            "dblp",
            "core",
            "invented"
          ],
          "title": "Origin",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Domain"
        },
        "range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Definition"
        }
      },
      "required": [
        "name",
        "iri",
        "kind",
        "origin"
      ],
      "title": "SchemaTerm",
      "type": "object"
    },
    "TraceRow": {
      "additionalProperties": false,
      "properties": {
        "atS": {
          "title": "Ats",
          "type": "number"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "returned": {
          "title": "Returned",
          "type": "string"
        },
        "reading": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading"
        },
        "spanId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spanid"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "targetClaim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetclaim"
        },
        "expectedEvidenceType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedevidencetype"
        }
      },
      "required": [
        "atS",
        "action",
        "returned"
      ],
      "title": "TraceRow",
      "type": "object"
    },
    "Triple": {
      "additionalProperties": false,
      "properties": {
        "s": {
          "title": "S",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "string"
        },
        "o": {
          "title": "O",
          "type": "string"
        },
        "support": {
          "title": "Support",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "tripleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tripleid"
        }
      },
      "required": [
        "s",
        "p",
        "o",
        "support",
        "evidence",
        "source"
      ],
      "title": "Triple",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "durationS": {
      "title": "Durations",
      "type": "number"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "path": {
      "enum": [
        "agentic",
        "baseline",
        "baseline-enhanced"
      ],
      "title": "Path",
      "type": "string"
    },
    "budget": {
      "enum": [
        "fast",
        "slow"
      ],
      "title": "Budget",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "corpus_absent",
        "no_evidence_found",
        "awaiting_reading",
        "incomplete",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "readings": {
      "items": {
        "$ref": "#/$defs/Reading"
      },
      "title": "Readings",
      "type": "array"
    },
    "chosenReading": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chosenreading"
    },
    "plans": {
      "items": {
        "type": "string"
      },
      "title": "Plans",
      "type": "array"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/TraceRow"
      },
      "title": "Trace",
      "type": "array"
    },
    "rating": {
      "anyOf": [
        {
          "enum": [
            "useful",
            "partial",
            "not_useful"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "producingPath": {
      "anyOf": [
        {
          "enum": [
            "agentic",
            "baseline",
            "baseline-enhanced",
