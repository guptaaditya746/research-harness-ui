{
  "$defs": {
    "ClaimField": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "title": "Value",
          "type": "string"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceids",
          "type": "array"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "value",
        "sourceIds"
      ],
      "title": "ClaimField",
      "type": "object"
    },
    "ClaimRelation": {
      "additionalProperties": false,
      "properties": {
        "sourceClaim": {
          "title": "Sourceclaim",
          "type": "string"
        },
        "targetClaim": {
          "title": "Targetclaim",
          "type": "string"
        },
        "relation": {
          "enum": [
            "supports",
            "contradicts",
            "qualifies",
            "sameContext",
            "differentContext",
            "possibleConflict",
            "confirmedConflict",
            "equivalentTo"
          ],
          "title": "Relation",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "sourceClaim",
        "targetClaim",
        "relation",
        "reason"
      ],
      "title": "ClaimRelation",
      "type": "object"
    },
    "ClaimSubgraph": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "MetadataClaim",
            "ResultClaim",
            "ComparisonClaim",
            "MethodClaim",
            "LimitationClaim",
            "RankingClaim",
            "SynthesisClaim"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paperId": {
          "title": "Paperid",
          "type": "string"
        },
        "fields": {
          "additionalProperties": {
            "$ref": "#/$defs/ClaimField"
          },
          "title": "Fields",
          "type": "object"
        },
        "sourceIds": {
          "items": {
            "type": "string"
          },
          "title": "Sourceids",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "object"
        },
        "evidenceAnchors": {
          "items": {
            "$ref": "#/$defs/EvidenceAnchor"
          },
          "title": "Evidenceanchors",
          "type": "array"
        },
        "supportedBy": {
          "items": {
            "type": "string"
          },
          "title": "Supportedby",
          "type": "array"
        },
        "status": {
          "default": "accepted",
          "enum": [
            "accepted",
            "partial"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "paperId",
        "fields",
        "sourceIds",
        "evidence"
      ],
      "title": "ClaimSubgraph",
      "type": "object"
    },
    "EvaluationSnapshot": {
      "additionalProperties": false,
      "properties": {
        "corpusSnapshotId": {
          "title": "Corpussnapshotid",
          "type": "string"
        },
        "ontologyVersion": {
          "title": "Ontologyversion",
          "type": "string"
        },
        "claimSchemaVersion": {
          "title": "Claimschemaversion",
          "type": "string"
        },
        "goldVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goldversion"
        },
        "retrievalIndexVersion": {
          "title": "Retrievalindexversion",
          "type": "string"
        }
      },
      "required": [
        "corpusSnapshotId",
        "ontologyVersion",
        "claimSchemaVersion",
        "retrievalIndexVersion"
      ],
      "title": "EvaluationSnapshot",
      "type": "object"
    },
    "EvidenceAnchor": {
      "additionalProperties": false,
      "description": "A reproducible source location, independent of the tool that found it.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "dblp_fact",
            "passage",
            "table_cell",
            "figure_annotation",
            "citation_fact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "paperId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paperid"
        },
        "sourceId": {
          "title": "Sourceid",
          "type": "string"
        },
        "locator": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "title": "Locator",
          "type": "object"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        }
      },
      "required": [
        "id",
        "kind",
        "sourceId"
      ],
      "title": "EvidenceAnchor",
      "type": "object"
    },
    "Metrics": {
      "additionalProperties": false,
      "properties": {
        "disagreement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disagreement"
        },
        "precision": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision"
        },
        "recall": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recall"
        }
      },
      "title": "Metrics",
      "type": "object"
    },
    "Reading": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "gloss": {
          "title": "Gloss",
          "type": "string"
        },
        "classes": {
          "items": {
            "type": "string"
          },
          "title": "Classes",
          "type": "array"
        },
        "axioms": {
          "items": {
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Axioms",
          "type": "array"
        },
        "sparql": {
          "title": "Sparql",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "triples": {
          "items": {
            "$ref": "#/$defs/Triple"
          },
          "title": "Triples",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/ClaimSubgraph"
          },
          "title": "Claims",
          "type": "array"
        },
        "claimRelations": {
          "items": {
            "$ref": "#/$defs/ClaimRelation"
          },
          "title": "Claimrelations",
          "type": "array"
        },
        "answerClaimIds": {
          "items": {
            "type": "string"
          },
          "title": "Answerclaimids",
          "type": "array"
        },
        "metrics": {
          "$ref": "#/$defs/Metrics"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "answered",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        },
        "op": {
          "default": "",
          "title": "Op",
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "title": "Properties"
        }
      },
      "required": [
        "label",
        "gloss",
        "classes",
        "axioms",
        "sparql",
        "answer",
        "triples",
        "metrics"
      ],
      "title": "Reading",
      "type": "object"
    },
    "TraceRow": {
      "additionalProperties": false,
      "properties": {
        "atS": {
          "title": "Ats",
          "type": "number"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "returned": {
          "title": "Returned",
          "type": "string"
        },
        "reading": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading"
        },
        "spanId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spanid"
        },
        "purpose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Purpose"
        },
        "targetClaim": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetclaim"
        },
        "expectedEvidenceType": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expectedevidencetype"
        }
      },
      "required": [
        "atS",
        "action",
        "returned"
      ],
      "title": "TraceRow",
      "type": "object"
    },
    "Triple": {
      "additionalProperties": false,
      "properties": {
        "s": {
          "title": "S",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "string"
        },
        "o": {
          "title": "O",
          "type": "string"
        },
        "support": {
          "title": "Support",
          "type": "string"
        },
        "evidence": {
          "title": "Evidence",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "tripleId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tripleid"
        }
      },
      "required": [
        "s",
        "p",
        "o",
        "support",
        "evidence",
        "source"
      ],
      "title": "Triple",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "durationS": {
      "title": "Durations",
      "type": "number"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "path": {
      "enum": [
        "agentic",
        "baseline",
        "baseline-enhanced"
      ],
      "title": "Path",
      "type": "string"
    },
    "budget": {
      "enum": [
        "fast",
        "slow"
      ],
      "title": "Budget",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "corpus_absent",
        "no_evidence_found",
        "awaiting_reading",
        "incomplete",
        "stopped"
      ],
      "title": "Status",
      "type": "string"
    },
    "readings": {
      "items": {
        "$ref": "#/$defs/Reading"
      },
      "title": "Readings",
      "type": "array"
    },
    "chosenReading": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chosenreading"
    },
    "plans": {
      "items": {
        "type": "string"
      },
      "title": "Plans",
      "type": "array"
    },
    "trace": {
      "items": {
        "$ref": "#/$defs/TraceRow"
      },
      "title": "Trace",
      "type": "array"
    },
    "rating": {
      "anyOf": [
        {
          "enum": [
            "useful",
            "partial",
            "not_useful"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rating"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "producingPath": {
      "anyOf": [
        {
          "enum": [
            "agentic",
            "baseline",
            "baseline-enhanced",
            "baseline_fallback"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Producingpath"
    },
    "executionStatus": {
      "anyOf": [
        {
          "enum": [
            "completed",
            "degraded",
            "failed"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Executionstatus"
    },
    "evidenceSurface": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidencesurface"
    },
    "searchCoverage": {
      "anyOf": [
        {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Searchcoverage"
    },
    "evaluationMode": {
      "default": false,
      "title": "Evaluationmode",
      "type": "boolean"
    },
    "snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/EvaluationSnapshot"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "coverage": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Coverage"
    },
    "theta": {
      "default": 0.3,
      "title": "Theta",
      "type": "number"
    },
    "modelAgent": {
      "default": "",
      "title": "Modelagent",
      "type": "string"
    },
    "modelSmall": {
      "default": "",
      "title": "Modelsmall",
      "type": "string"
    },
    "promptHashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Prompthashes",
      "type": "object"
    },
    "artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    }
  },
  "required": [
    "id",
    "startedAt",
    "durationS",
    "question",
    "path",
    "budget",
    "status"
  ],
  "title": "Run",
  "type": "object"
}
