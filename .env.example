# Research Harness — environment
#
# Copy to .env and fill in. Never commit .env. Every variable below is read
# through packages/config (harness_config.Settings), which loads the nearest
# .env on import; tests/test_config.py fails when a variable here has no
# setting. Models are served by thesis-llm-setup (aliases heavy-model,
# lite-model, qwen-embed behind LiteLLM).

# ─── Models ─────────────────────────────────────────────────────────────────
HARNESS_MODEL_AGENT=lite-model      # Granite: concept proposals and the MCP tool loop
HARNESS_MODEL_SMALL=heavy-model     # structured extraction and planning (~30 calls per run); an INSTRUCT model
HARNESS_MODEL_EDC=lite-model        # open extraction, predicate definition, relation mapping; empty = HARNESS_MODEL_SMALL
HARNESS_MODEL_HIGH=heavy-model      # schema inference, evidence review, verification in agentic runs
HARNESS_MODEL_JUDGE=heavy-model     # independent verifier; must differ from HARNESS_MODEL_AGENT
HARNESS_MODEL_EMBEDDING=qwen-embed     # dense passage index (make embed) and query embeddings
HARNESS_MODEL_RERANK=               # optional served reranker alias (LiteLLM /rerank); empty = fused order
HARNESS_MAX_OUTPUT_TOKENS=4096      # output limit for structured calls; a cut-off reply is reported as such
HARNESS_PROMPT_SET=v2               # v2 = current prompts; v1 = the prompts before templating (for comparison)
HARNESS_MODEL_STREAM=false          # true: stream replies so a stopped run closes its connection and vLLM aborts
PROVIDER_MAX_RETRIES=3              # attempts for transient provider errors (connection, 429, 5xx)
HARNESS_MODEL_CALL_THREADS=16       # worker threads for interruptible model calls
# Per-alias request options (JSON), e.g. for a hybrid Qwen3 model served by vLLM:
# HARNESS_MODEL_OPTIONS={"heavy-model": {"max_tokens": 6144, "extra_body": {"chat_template_kwargs": {"enable_thinking": false}}}}
HARNESS_MODEL_OPTIONS=

# ─── Endpoints ──────────────────────────────────────────────────────────────
LITELLM_BASE_URL=http://127.0.0.1:4000/v1
VLLM_API_KEY=sk-local-vllm          # bearer key for LiteLLM; must equal LITELLM_MASTER_KEY in thesis-llm-setup
LLM_STATUS_URL=http://127.0.0.1:8010/v1/status   # thesis-llm-setup status API (Heavy load, preemptions)
VLLM_HEAVY_API_BASE=http://127.0.0.1:8002/v1     # fallback load probe only; model calls always go through LiteLLM
HARNESS_MODEL_AGENT_URL=http://127.0.0.1:4000/v1 # M1 corpus-only probe (python -m harness_mcp_corpus.probe)
MCP_CORPUS_URL=http://127.0.0.1:8765/mcp         # what the API/agent process connects to
MCP_CORPUS_TRANSPORT=streamable-http             # stdio | streamable-http
MCP_CORPUS_HOST=127.0.0.1
MCP_CORPUS_PORT=8765
GROBID_URL=http://127.0.0.1:8070
DATABASE_URL=postgresql+psycopg://harness:harness@localhost:5432/harness
API_CORS_ORIGINS=http://localhost:5173
SSE_KEEPALIVE_SECONDS=15

# ─── Budgets and limits ─────────────────────────────────────────────────────
BUDGET_BASELINE_FAST_SECONDS=60     # per model call; structured Qwen replies often exceed 15 s
BUDGET_BASELINE_SLOW_SECONDS=90
BUDGET_AGENTIC_FAST_SECONDS=45
BUDGET_AGENTIC_SLOW_SECONDS=120
HARNESS_RUN_DEADLINE_FAST_S=300     # hard wall-clock limit per run; also HARNESS_RUN_DEADLINE_<PATH>_<BUDGET>_S
HARNESS_RUN_DEADLINE_SLOW_S=900
HARNESS_RUN_DEADLINE_AGENTIC_SLOW_S=300
HARNESS_MAX_CONCURRENT_RUNS=2       # model-backed runs at once; others queue
HARNESS_MAX_CONCURRENT_HEAVY=1
HARNESS_HEAVY_QUEUE_THRESHOLD=8     # defer heavy calls when this many requests wait on Heavy, or when it is saturated
BASELINE_RETRIEVE_K=20
HARNESS_RETRIEVAL_MODE=lexical      # pipeline retrieval: lexical, or hybrid (BM25 + dense, fused; measure on gold first)
HARNESS_ADAPTIVE_MAX_PASSAGES=16    # cap open extraction work in adaptive mode
HARNESS_AGENTIC_MAX_PASSAGES=12     # cap open extraction work in agentic mode; MCP seeds take priority
HARNESS_AGENTIC_MAX_MCP_SEEDS=6     # MCP passages handed to the shared pipeline (see docs/KNOWN_ISSUES.md)

# ─── Agent loop ─────────────────────────────────────────────────────────────
HARNESS_AGENT_CONTEXT_TOKENS=32768  # served max_model_len of the agent model; empty = ask LiteLLM, else learn from errors
HARNESS_AGENT_REPLY_TOKENS=2048     # reply budget per agent turn (never more than a quarter of the window)
HARNESS_AGENT_REFLECTIONS=1         # rejected decisions sent back with their problems before the run degrades
HARNESS_AGENT_FIRST_TOOL_CHOICE=required  # tool_choice until the agent's first corpus tool call (required | auto)
HARNESS_MCP_AGENT_TIMEOUT_S=90      # bound on MCP research; observed passages still seed retrieval on timeout
READINGS_MIN=3                      # concept readings proposed before agentic research (3-4)
READINGS_MAX=4

# ─── Paths, datasets and evaluation snapshot ────────────────────────────────
CORPUS_ROOT=./corpus_data           # papers.jsonl, passages.jsonl, facts.jsonl, references.jsonl, index/
ARTIFACT_ROOT=./artifacts           # one folder per run (see docs/RUN_ANALYSIS.md)
DATASETS_ROOT=./datasets
FIXTURES_DIR=./web/fixtures         # generated by `make fixtures` from packages/schema
HARNESS_INCLUDE_FIXTURES=true       # set false on live deployments so recorded demo runs are not listed
HARNESS_QUESTION_SETS=question_matrix_20.json,question_library_2025.json,corpus_10.json
DBLP_SCHEMA_PATH=                   # empty = seed/dblp_schema_2024-06-14.ttl
# Shared corpus_10 normalizer and vocabulary from the labelling checkout.
LABELLING_NORMALIZATION_FILE=
LABELLING_VOCABULARY_FILE=
# Evaluation (see packages/evaluation/README.md and labelling/docs/EVALUATION.md).
HARNESS_PREDICATE_RELATIONS_FILE=   # empty = datasets/ontology/predicate_relations.ttl (rules for the entailed level)
HARNESS_JUDGE_CACHE_FILE=           # empty = $ARTIFACT_ROOT/judge_cache.jsonl (soft-match judge decisions)
# Must equal labelling's .env so gold rows pair with benchmark runs.
CORPUS_FINGERPRINT=unknown
CORPUS_SNAPSHOT_ID=
ONTOLOGY_VERSION=2024-06-14
ONTOLOGY_HASH=unknown
RETRIEVAL_INDEX_VERSION=bm25s-v1

# ─── Observability ──────────────────────────────────────────────────────────
HARNESS_ENV=development
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Public gateway (packages/public_gateway only) ──────────────────────────
# Never expose the secret below to Vite/Pages.
HARNESS_MAX_CONCURRENT_PUBLIC_RUNS=1
PUBLIC_PRIVATE_ORIGIN=http://127.0.0.1:8000
PUBLIC_ALLOWED_ORIGINS=https://public.example.edu
PUBLIC_IDENTITY_SALT=replace-with-a-random-private-value
PUBLIC_TURNSTILE_ENABLED=true
PUBLIC_ENV=production
PUBLIC_DEV_BYPASS=false
PUBLIC_FAST_ENABLED=true
PUBLIC_ADAPTIVE_ENABLED=true
PUBLIC_TRUST_CLIENT_ID=false
PUBLIC_MAX_QUEUE=10
PUBLIC_MAX_STARTS_PER_DAY=3
PUBLIC_MAX_ACTIVE_PER_CLIENT=1
PUBLIC_MAX_IDENTITIES=10000
PUBLIC_MAX_BODY_BYTES=4096
PUBLIC_QUESTION_MIN_CHARS=8
PUBLIC_QUESTION_MAX_CHARS=500
PUBLIC_FAST_DEADLINE_SECONDS=90
PUBLIC_ADAPTIVE_DEADLINE_SECONDS=180
TURNSTILE_SECRET_KEY=
