# Research Harness — environment

# Copy to .env and fill in. Never commit .env. Every variable here is read by

# packages/runs/config.py (pydantic-settings); unknown variables are rejected.
 
# ─── Models ────────────────────────────────────────────────────────────────

# LangChain init_chat_model strings: "<provider>:<model>". Examples:

#   anthropic:claude-sonnet-4-6   openai:gpt-5   ollama:qwen3:32b   google_genai:gemini-2.5-pro

HARNESS_MODEL_AGENT=qwen-chat       # main agent, schema_binder, sparql_writer, graph_builder (slow), answer_writer, verifier

HARNESS_MODEL_HIGH=heavy-model      # higher-quality planner/supervisor model for agentic runs
HARNESS_MAX_CONCURRENT_RUNS=2       # queue model-backed runs to avoid proxy overload
HARNESS_MAX_CONCURRENT_HEAVY=1      # one heavy-model agentic run at a time
HARNESS_MCP_AGENT_TIMEOUT_S=240     # bound the MCP supervisor phase (never below 2x one agent turn)
HARNESS_AGENT_CONTEXT_TOKENS=       # served max_model_len of the agent model; empty = ask LiteLLM, else learn from errors
HARNESS_AGENT_REPLY_TOKENS=2048     # reply budget per agent turn (never more than a quarter of the window)
HARNESS_RUN_DEADLINE_FAST_S=300     # hard wall-clock limit per run; Stop and this limit cancel cooperatively
HARNESS_RUN_DEADLINE_SLOW_S=900
HARNESS_INCLUDE_FIXTURES=true       # set false on live deployments so recorded demo runs are not listed
HARNESS_HEAVY_QUEUE_THRESHOLD=8     # defer heavy calls when vLLM reports this many waiting requests

HARNESS_MODEL_SMALL=qwen-chat       # extraction, planning and ingest passes (~30 structured calls per run): use an INSTRUCT model, not a thinking model
HARNESS_MAX_OUTPUT_TOKENS=4096      # output limit for structured calls; a cut-off reply is reported as such
# Per-alias request options (JSON). Example for a Qwen3 hybrid model served by vLLM:
# HARNESS_MODEL_OPTIONS={"heavy-model": {"max_tokens": 6144, "extra_body": {"chat_template_kwargs": {"enable_thinking": false}}}}
HARNESS_MODEL_OPTIONS=

HARNESS_MODEL_JUDGE=heavy-model     # LLM-as-judge; must differ from HARNESS_MODEL_AGENT

HARNESS_MODEL_EMBEDDING=qwen-embed

# OpenAI-compatible LiteLLM proxy running on the same compute node.
LITELLM_BASE_URL=http://127.0.0.1:4000/v1

# Used by the M1 corpus-only probe; points to the same LiteLLM proxy.
HARNESS_MODEL_AGENT_URL=http://127.0.0.1:4000/v1

VLLM_API_KEY=sk-local-vllm
VLLM_API_BASE=http://127.0.0.1:8002/v1
VLLM_HEAVY_API_BASE=http://gammaweb09:8002/v1
VLLM_LITE_API_BASE=http://127.0.0.1:8002/v1
VLLM_EMBED_API_BASE=http://127.0.0.1:8001/v1

HARNESS_MODEL_TEMPERATURE_PLANNER=0.7

HARNESS_MODEL_TEMPERATURE_DEFAULT=0.0
 
# Provider keys — set only the ones your model strings use

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

GOOGLE_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
 
# ─── Database ───────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+psycopg://harness:harness@localhost:5432/harness

# LangGraph checkpointer (same DB by default; separate if you want isolation)

CHECKPOINTER_URL=postgresql://harness:harness@localhost:5432/harness

POSTGRES_USER=harness

POSTGRES_PASSWORD=harness

POSTGRES_DB=harness
 
# ─── Storage ────────────────────────────────────────────────────────────────

ARTIFACT_ROOT=./artifacts            # per-run artifact files; S3-compatible later via ARTIFACT_S3_*

CORPUS_ROOT=./corpus_data            # papers.jsonl, passages.jsonl, facts.jsonl, index/, outlines/

CORPUS_ID=default                    # registry scope; one registry of minted terms per corpus

INGEST_CACHE_ROOT=./corpus_data/.cache   # content-hash cache for one-time LLM ingest passes

# ARTIFACT_S3_ENDPOINT=

# ARTIFACT_S3_BUCKET=

# ARTIFACT_S3_ACCESS_KEY=

# ARTIFACT_S3_SECRET_KEY=
 
# ─── Semantic layer ─────────────────────────────────────────────────────────

HARNESS_NAMESPACE=https://harness.local/schema#     # hrn: — change to your real domain before sharing graphs

HARNESS_RESOURCE_NAMESPACE=https://harness.local/resource/  # papers, passages, authors, runs

SEED_DBLP_SCHEMA_URL=https://dblp.org/rdf/schema

SEED_CITO_URL=https://purl.org/spar/cito

SEED_FABIO_URL=https://purl.org/spar/fabio

SEED_DOCO_URL=https://purl.org/spar/doco

SEED_CACHE_DIR=./corpus_data/.seeds  # seeds are fetched once and cached; runs never hit the network for them

MINT_SIMILARITY_CUTOFF=0.85          # resolve_concept: above this, minting is refused and the seed term is used

TITLE_MATCH_CUTOFF=0.90              # references.jsonl: fuzzy title resolution to an in-corpus paper
 
# ─── Disagreement and readings ──────────────────────────────────────────────

DISAGREEMENT_THETA=0.30              # concept_disagreement >= theta -> ambiguous (op_disagreement > 0 always does)

PLANNER_COUNT=3

READINGS_MIN=2

READINGS_MAX=4

READING_GROUNDING_MIN_HITS=1         # corpus.search hits required for a reading to be kept
 
# ─── Budgets (seconds / counts) ─────────────────────────────────────────────

BUDGET_AGENTIC_FAST_SECONDS=45

BUDGET_AGENTIC_SLOW_SECONDS=120

BUDGET_BASELINE_FAST_SECONDS=60        # per model call; structured Qwen responses routinely take >15s

BUDGET_BASELINE_SLOW_SECONDS=90

BUDGET_WARN_FRACTION=0.85            # BudgetMiddleware injects "finish and stop" at this fraction

LEDGER_FAST_CAP=60                   # obligations beyond this are out_of_budget on fast

LEDGER_SLOW_CAP=0                    # 0 = uncapped

MAX_AGENT_STEPS_FAST=40

MAX_AGENT_STEPS_SLOW=150

BASELINE_RETRIEVE_K=20

SCHEMA_MAX_ATTEMPTS=3                # schema_rejected after this

SPARQL_MAX_ATTEMPTS=3                # query_rejected after this

PROVIDER_MAX_RETRIES=3               # provider_error after this (exponential backoff)
 
# ─── Corpus / ingest ────────────────────────────────────────────────────────

GROBID_URL=http://localhost:8070

PDF_PARSER=grobid                    # grobid | docling ; docling is also the automatic fallback when GROBID rejects a file

INGEST_LLM_PASSES=section_roles,entities,results,citation_intent,corpus_map   # comma list; empty = structural facts only (M1)

BM25_INDEX_DIR=./corpus_data/index/bm25

SEARCH_DEFAULT_K=10

SEARCH_MAX_K=50

PASSAGE_SPAN_ATTR_LIMIT_BYTES=4096   # passage text above this is replaced by its id in span attributes
 
# ─── MCP corpus server ──────────────────────────────────────────────────────

MCP_CORPUS_TRANSPORT=streamable-http # stdio | streamable-http

MCP_CORPUS_HOST=127.0.0.1

MCP_CORPUS_PORT=8765

MCP_CORPUS_URL=http://127.0.0.1:8765/mcp   # what the API/agent process connects to
 
# External enrichment tools — off unless your network allows it

EXTERNAL_TOOLS_ENABLED=false

OPENALEX_MAILTO=                     # polite-pool email for OpenAlex

SEMANTIC_SCHOLAR_API_KEY=

DBLP_API_BASE=https://dblp.org/search/publ/api
 
# ─── API / web ──────────────────────────────────────────────────────────────

API_HOST=0.0.0.0

API_PORT=8000

API_CORS_ORIGINS=http://localhost:5173

SSE_KEEPALIVE_SECONDS=15

VITE_API_BASE=http://localhost:8000   # read by web/ at build time
 
# ─── Observability ──────────────────────────────────────────────────────────

LANGFUSE_PUBLIC_KEY=

LANGFUSE_SECRET_KEY=

LANGFUSE_BASE_URL=https://cloud.langfuse.com

OTEL_EXPORTER_OTLP_ENDPOINT=         # optional collector for additional OpenTelemetry export

OTEL_SERVICE_NAME=research-harness

OTEL_TRACES_SAMPLER=always_on

HARNESS_TRACE_FULL_TOOL_IO=true      # record full tool input/output on spans (subject to the passage byte limit above)

LOG_LEVEL=INFO

LOG_FORMAT=json                      # json | console

# Force off so deepagents' imported LangSmith context stays inert — do not set to true

LANGSMITH_TRACING=false

LANGCHAIN_TRACING_V2=false
 
# ─── Evaluation ─────────────────────────────────────────────────────────────

DATASETS_ROOT=./datasets

EVAL_RESULTS_ROOT=./results

JUDGE_AGREEMENT_KAPPA_BAR=0.60       # judge is only reported as agreeing with humans above this, after >= JUDGE_MIN_RATED_RUNS

JUDGE_MIN_RATED_RUNS=100

EVAL_AUTO_RESUME_READING=gold        # gold | first | all  (how the offline runner resolves interrupt())

SMOKE_SET_PATH=./datasets/smoke.jsonl

LLM_CASSETTES_DIR=./tests/cassettes  # recorded LLM responses for deterministic tests

LLM_RECORD_MODE=none                 # none | once | all  (VCR-style)
 
# ─── Dev ────────────────────────────────────────────────────────────────────

HARNESS_ENV=dev                      # dev | test | prod

FIXTURES_DIR=./web/fixtures          # generated by `make fixtures` from packages/schema
