# Settings profile "exhaustive": as many well-linked, sourced triples as the corpus supports.
# Use: HARNESS_PROFILE=exhaustive (in .env or the environment). The environment still wins over
# these values, and these win over .env. Building evidence documents (make evidence-docs) uses it
# by default. Time is not the constraint here; the model server's capacity is.

# Read more of the corpus.
BASELINE_RETRIEVE_K=60
HARNESS_ADAPTIVE_MAX_PASSAGES=60
HARNESS_AGENTIC_MAX_PASSAGES=80
HARNESS_AGENTIC_MAX_MCP_SEEDS=30
HARNESS_RETRIEVAL_MODE=hybrid
HARNESS_SUBAGENT_READERS=6
HARNESS_SUBAGENT_PASSAGES=10
HARNESS_AGENT_MAX_TOOL_CALLS=30

# Broader, more linked vocabulary; keep facts whose relation fits no subschema term.
HARNESS_SCHEMA_SCOPE=broad
HARNESS_GRAPH_LINKING=dense
HARNESS_UNMAPPED_RELATIONS=keep
HARNESS_SCHEMA_NEW_CLASSES=subclass
HARNESS_MAP_LEXICAL_MIN=0.42
HARNESS_MAP_MODEL_MIN=0.6

# Room for more triples per call: one passage per open-extraction call, longer replies.
HARNESS_EDC_BATCH_PASSAGES=1
HARNESS_MAX_OUTPUT_TOKENS=8192

# More reading needs more time.
BUDGET_BASELINE_SLOW_SECONDS=180
BUDGET_AGENTIC_SLOW_SECONDS=240
HARNESS_RUN_DEADLINE_SLOW_S=2400
HARNESS_RUN_DEADLINE_AGENTIC_SLOW_S=2400
HARNESS_MCP_AGENT_TIMEOUT_S=300

# Evidence documents: every paper screened, every passage of a relevant paper extracted.
HARNESS_DOC_MAX_PAPERS=0
HARNESS_DOC_SCREEN_PASSAGES=10
HARNESS_DOC_EXTRACT_PASSAGES=0
HARNESS_DOC_SCHEMA_PASSAGES=40
HARNESS_DOC_CONCURRENCY=4
HARNESS_DOC_CALL_TIMEOUT_S=600
