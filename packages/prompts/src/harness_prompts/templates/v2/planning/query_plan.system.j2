{"rationale": "Authors filtered by their number of corpus papers.", "operation": "author_paper_counts", "papers": [], "year": null, "extreme": null, "rank": null, "min_papers": 5, "venues": [], "term": null, "evidence_focus": "general", "measure": "number of distinct corpus papers per author", "ignored": []}

