{"rationale": "Intersects the authors of the papers in two venues.", "operation": "authors_in_venues", "papers": [], "year": null, "extreme": null, "rank": null, "min_papers": null, "venues": ["ACL 2025", "EMNLP 2025"], "term": null, "evidence_focus": "general", "benchmark": null, "measure": "authors with a corpus paper in every named venue (DBLP venue facts)"}

