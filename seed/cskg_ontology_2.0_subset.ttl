# Subset of the Computer Science Knowledge Graph (CS-KG) Ontology 2.0: the harness content core.
#
# Source:  https://scholkg.kmi.open.ac.uk/cskg/ontology  (namespace https://w3id.org/cskg/ontology#)
#          read from /tmp/cskg_ontology.ttl, SHA-256 e1d889a3d44b648417d406755d866cc1385af7cb4035418b826a35991ff321dd
# Licence: CC BY 4.0 (https://creativecommons.org/licenses/by/4.0/), (c) the CS-KG authors,
#          Knowledge Media Institute, The Open University. Terms and statements are copied unchanged.
#
# Written by scripts/cskg_subset.py (make cskg-subset): every statement the source makes about the
# research-entity classes and the base relations the harness names (harness_semantic), and their
# inverses. The harness names these terms through its own vocabulary (hrn:Method owl:equivalentClass
# cskg-ont:Method, hrn:uses owl:equivalentProperty cskg-ont:uses).

@prefix cskg-ont: <https://w3id.org/cskg/ontology#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://harness.local/ontology/cskg-2.0-subset> a owl:Ontology ;
    rdfs:label "CS-KG Ontology 2.0, harness subset" ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:source cskg-ont: ;
    owl:versionInfo 2.0 .

cskg-ont:Material a owl:Class ;
    rdfs:comment "An object that is processed, used, or returned by methods in order to pursue a task. In computer science it is typically  a data set, a knowledge base, or a system. Some examples include 'vocabulary', 'biometric data', 'Wordnet', and 'social network'." ;
    rdfs:subClassOf cskg-ont:ResearchEntity .

cskg-ont:Method a owl:Class ;
    rdfs:comment "A specific approach, usually adopted to address a task.  Some examples include 'neural networks', decision trees', 'principal component analysis', 'support vector machine', and 'fuzzy logic'." ;
    rdfs:subClassOf cskg-ont:ResearchEntity .

cskg-ont:Metric a owl:Class ;
    rdfs:comment "A measure of quantitative assessment, commonly used for comparing or assessing the performance of a method.  Some examples include 'word error rate', 'minimum classification error', 'normalized mutual information', and 'fault exposure ratio'." ;
    rdfs:subClassOf cskg-ont:ResearchEntity .

cskg-ont:OtherEntity a owl:Class ;
    rdfs:comment "A significant entity that we were unable to classify as task, method, metric, or material. It usually refers to real world entities that are used by or affect tasks and methods. Some examples include 'password', 'keyboard', 'fingerprint', and 'pixel'." ;
    rdfs:subClassOf cskg-ont:ResearchEntity .

cskg-ont:Task a owl:Class ;
    rdfs:comment "A piece of work to carry out, usually to solve a specific challenge. Some examples include 'knowledge discovery', 'dimensionality reduction', 'computer vision', and 'authentication'." ;
    rdfs:subClassOf cskg-ont:ResearchEntity .

cskg-ont:analyzedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:analyzes .

cskg-ont:improvedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:improves .

cskg-ont:includedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:includes .

cskg-ont:outperformedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:outperforms .

cskg-ont:producedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:produces .

cskg-ont:solvedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:solves .

cskg-ont:supportedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:supports .

cskg-ont:usedBy a owl:ObjectProperty ;
    owl:inverseOf cskg-ont:uses .

cskg-ont:analyzes a owl:ObjectProperty .

cskg-ont:improves a owl:ObjectProperty .

cskg-ont:includes a owl:ObjectProperty .

cskg-ont:outperforms a owl:ObjectProperty .

cskg-ont:produces a owl:ObjectProperty .

cskg-ont:solves a owl:ObjectProperty .

cskg-ont:supports a owl:ObjectProperty .

cskg-ont:uses a owl:ObjectProperty .

cskg-ont:ResearchEntity a owl:Class .

